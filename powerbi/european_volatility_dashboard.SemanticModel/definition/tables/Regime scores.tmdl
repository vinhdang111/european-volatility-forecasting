table 'Regime scores'
	lineageTag: 5ddbade1-133c-5c45-8679-a5988dfe61e4

	measure 'QLIKE calm' = ```
			
			        CALCULATE (
			            DIVIDE ( SUMX ( 'Regime scores', 'Regime scores'[qlike] * 'Regime scores'[n] ), SUM ( 'Regime scores'[n] ) ),
			            'Regime scores'[regime] = "Calm periods"
			        )
			```
		formatString: 0.000
		lineageTag: 557dedb9-b5c0-52f0-ac61-f97d3f7dc524

	measure 'QLIKE stress' = ```
			
			        CALCULATE (
			            DIVIDE ( SUMX ( 'Regime scores', 'Regime scores'[qlike] * 'Regime scores'[n] ), SUM ( 'Regime scores'[n] ) ),
			            'Regime scores'[regime] = "Stress periods"
			        )
			```
		formatString: 0.000
		lineageTag: f3bec491-e264-5bd5-9f73-35d17ba5c288

	measure 'QLIKE calm rank' = ```
			
			        IF (
			            NOT ISBLANK ( [QLIKE calm] ),
			            RANKX (
			                FILTER ( ALL ( 'Models' ), NOT ISBLANK ( CALCULATE ( [QLIKE calm] ) ) ),
			                CALCULATE ( [QLIKE calm] ),
			                [QLIKE calm],
			                ASC
			            )
			        )
			```
		formatString: 0
		lineageTag: 9c54fdeb-770d-5bd1-8fa8-8649f1962165

	measure 'QLIKE stress rank' = ```
			
			        IF (
			            NOT ISBLANK ( [QLIKE stress] ),
			            RANKX (
			                FILTER ( ALL ( 'Models' ), NOT ISBLANK ( CALCULATE ( [QLIKE stress] ) ) ),
			                CALCULATE ( [QLIKE stress] ),
			                [QLIKE stress],
			                ASC
			            )
			        )
			```
		formatString: 0
		lineageTag: 6298c98c-3e11-51b6-95f0-876d8b35d766

