table 'VaR yearly'
	lineageTag: b9d7351e-b1aa-45cf-aaa5-1088c9def30b

	measure Series-years = ```
			
			        COUNTROWS ( 'VaR yearly' )
			```
		formatString: 0
		lineageTag: c9844bbe-c441-4715-ae74-e9dedbc78604

	measure 'Green zone share' = ```
			
			        VAR all_years =
			            CALCULATE (
			                COUNTROWS ( 'VaR yearly' ),
			                REMOVEFILTERS ( 'VaR yearly'[zone_label], 'VaR yearly'[zone_order], 'VaR yearly'[zone] )
			            )
			        VAR green =
			            CALCULATE (
			                COUNTROWS ( 'VaR yearly' ),
			                REMOVEFILTERS ( 'VaR yearly'[zone_label], 'VaR yearly'[zone_order], 'VaR yearly'[zone] ),
			                'VaR yearly'[zone] = "green"
			            )
			        RETURN
			            DIVIDE ( green, all_years )
			```
		formatString: 0%;-0%;0%
		lineageTag: 16302b47-1a96-5ea6-8ee7-e51be5f485d1

