table 'Forecast paths'
	lineageTag: 1f00c6c3-aeea-4490-a0ca-64feb8995151

	measure 'Volatility (%)' = ```
			
			        AVERAGE ( 'Forecast paths'[vol_pct] )
			```
		formatString: 0.0
		lineageTag: 64ae6003-fe6c-40c5-89e0-ce73f24a609c

	measure 'QLIKE (period)' = ```
			
			        AVERAGEX (
			            'Forecast paths',
			            VAR ratio = DIVIDE ( 'Forecast paths'[realised_pct] ^ 2, 'Forecast paths'[vol_pct] ^ 2 )
			            RETURN ratio - LN ( ratio ) - 1
			        )
			```
		formatString: 0.000
		lineageTag: 0996d904-24dc-4f1f-84a7-b4a4ba8b9b9a

	measure 'QLIKE vs HAR-X (period)' = ```
			
			        VAR harx =
			            CALCULATE (
			                [QLIKE (period)],
			                REMOVEFILTERS ( 'Forecast paths'[line], 'Forecast paths'[line_order] ),
			                'Forecast paths'[line] = "HAR-X"
			            )
			        RETURN
			            IF ( NOT ISBLANK ( [QLIKE (period)] ), DIVIDE ( [QLIKE (period)], harx ) - 1 )
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 079800eb-538a-4479-84ab-9525e3352b56

	measure 'Peak volatility (%)' = ```
			
			        MAX ( 'Forecast paths'[vol_pct] )
			```
		formatString: 0.0
		lineageTag: c5849367-e7e4-53b8-a14d-7ca7a99c7be5

	measure 'QLIKE vs best (period)' = ```
			
			        VAR best =
			            CALCULATE (
			                MINX (
			                    FILTER ( VALUES ( 'Forecast paths'[line] ), 'Forecast paths'[line] <> "Realised" ),
			                    CALCULATE ( [QLIKE (period)] )
			                ),
			                REMOVEFILTERS ( 'Forecast paths'[line], 'Forecast paths'[line_order] )
			            )
			        RETURN
			            IF ( NOT ISBLANK ( [QLIKE (period)] ), DIVIDE ( [QLIKE (period)], best ) - 1 )
			```
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: ef76da93-cabc-5a54-9f29-28b2a3617651

	measure 'Best forecast (period)' = ```
			
			        VAR scores =
			            CALCULATETABLE (
			                FILTER (
			                    ADDCOLUMNS ( VALUES ( 'Forecast paths'[line] ), "@qlike", CALCULATE ( [QLIKE (period)] ) ),
			                    'Forecast paths'[line] <> "Realised" && NOT ISBLANK ( [@qlike] )
			                ),
			                REMOVEFILTERS ( 'Forecast paths'[line], 'Forecast paths'[line_order] )
			            )
			        RETURN
			            MAXX ( TOPN ( 1, scores, [@qlike], ASC ), 'Forecast paths'[line] )
			```
		lineageTag: e884d5ef-acb6-579e-9b3c-bd147d0002af

	measure 'Forecast bias (pts)' = ```
			
			        AVERAGEX ( 'Forecast paths', 'Forecast paths'[vol_pct] - 'Forecast paths'[realised_pct] )
			```
		formatString: +0.0;-0.0;0.0
		lineageTag: e5a8952a-5e69-5a29-9342-955e0082889e

