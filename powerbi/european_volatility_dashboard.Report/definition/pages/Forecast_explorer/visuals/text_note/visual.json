            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How to read",
                    "textStyle": {
                      "fontFamily": "'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
                      "fontSize": "14pt",
                      "color": "#003399"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Zoom on March 2020: when volatility jumps, the Transformer stays below the other forecasts. Accurate on average, too low when it matters.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "11pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Negative bias (orange) = forecasts too low on average, the dangerous side for risk; positive (blue) = too high. QLIKE punishes a forecast that is too low more than one that is too high.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "11pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Cards and bars always compare all five forecasts, whatever models are selected.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "11pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              }
            ]
